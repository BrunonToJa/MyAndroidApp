<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="16dp">

    <!-- TYTUŁ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ustawienia"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wprowadź dane i inne"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        android:layout_marginBottom="18dp"/>

<!-- GUZIK BROKERZY - FIOLETOWY -->
<Button
    android:id="@+id/btnBrokers"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="14dp"
    android:backgroundTint="#5741D9"
    android:text="Brokerzy"
    android:textColor="#FFFFFF"
    android:textAllCaps="false"
    android:textSize="16sp"
    android:gravity="center_vertical|center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"/>

<!-- GUZIK WŁASNY WYKRES - ZIELONY -->
<Button
    android:id="@+id/btnCustomChart"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:backgroundTint="#10B981"
    android:text="Dodaj dane"
    android:textColor="#FFFFFF"
    android:textAllCaps="false"
    android:textSize="16sp"
    android:gravity="center_vertical|center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"/>

<!-- GUZIK WYLOGUJ - CZERWONY -->
<Button
    android:id="@+id/btnLogout"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:backgroundTint="#DC2626"
    android:text="Wyloguj"
    android:textColor="#FFFFFF"
    android:textAllCaps="false"
    android:textSize="16sp"
    android:gravity="center_vertical|center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"/>

</LinearLayout>