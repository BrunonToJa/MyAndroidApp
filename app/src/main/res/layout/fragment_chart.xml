<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- GÓRNY PASEK (include) -->
    <include
        layout="@layout/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>

    <!-- KARTA 1 - WYKRES KOŁOWY -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="14dp">

        <!-- TŁO Z ROZMYCIEM -->
        <androidx.cardview.widget.CardView
            android:id="@+id/glassCardBg1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#60000000"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#90000000"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/glass_light"/>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- WYKRES KOŁOWY -->
        <com.example.mybussines.utils.SimplePieChartView
            android:id="@+id/pieChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"/>

    </FrameLayout>

    <!-- KARTA 2 - WYKRES LINIOWY -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <!-- TŁO Z ROZMYCIEM -->
        <androidx.cardview.widget.CardView
            android:id="@+id/glassCardBg2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#60000000"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#90000000"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/glass_light"/>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- WYKRES LINIOWY -->
        <com.example.mybussines.utils.SimpleChartView
            android:id="@+id/simpleChart2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"/>

    </FrameLayout>

</LinearLayout>