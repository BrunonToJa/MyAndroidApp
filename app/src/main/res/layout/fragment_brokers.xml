<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- PASEK WSTECZ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1A1A1A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="← Wstecz"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

    </androidx.cardview.widget.CardView>

    <!-- TYTUŁ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wybierz brokera"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- GUZIK XTB - STYL JAK Z LOGOWANIA -->
    <Button
        android:id="@+id/btnXTB"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#FF0000"
        android:text="Połącz z XTB"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:gravity="center_vertical|center_horizontal"
        android:drawableLeft="@drawable/logo_xtb"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>

    <Button
        android:id="@+id/btnKraken"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#5741D9"
        android:drawableLeft="@drawable/ic_kraken"
        android:gravity="center_vertical|center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Połącz z Kraken"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>